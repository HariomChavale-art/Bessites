
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Stacks Ecosystem ---
    
    match /stacks/{stackId} {
      allow read: if resource.data.isPublic == true || (isAuthenticated() && resource.data.creatorId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;

      match /items/{itemId} {
        allow read: if true;
        allow write: if isAuthenticated() && get(/databases/$(database)/documents/stacks/$(stackId)).data.creatorId == request.auth.uid;
      }
    }

    match /stackVotes/{voteId} {
      allow read: if true;
      allow create: if isAuthenticated() && voteId == request.resource.data.stackId + '_' + request.auth.uid;
      allow delete: if isAuthenticated() && voteId.split('_')[1] == request.auth.uid;
    }

    match /stackSaves/{saveId} {
      allow read: if isAuthenticated() && saveId.split('_')[1] == request.auth.uid;
      allow create: if isAuthenticated() && saveId == request.resource.data.stackId + '_' + request.auth.uid;
      allow delete: if isAuthenticated() && saveId.split('_')[1] == request.auth.uid;
    }

    // --- Existing Rules ---
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
    
    match /submissions/{subId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid);
    }

    match /websiteStats/{siteId} {
      allow read, write: if true;
    }

    match /collections_sites/{siteId} {
      allow read, write: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
