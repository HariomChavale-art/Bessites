rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Check if the user is the owner of a submission associated with the stats ID
    function isSubmissionOwner(submissionId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
        get(/databases/$(database)/documents/submissions/$(submissionId)).data.userId == request.auth.uid;
    }

    // User Profile Rules
    match /users/{userId} {
      // Users can read other profiles for creator attribution. 
      // Collection-level read is allowed for authenticated users to support discovery/admin views.
      allow read: if request.auth != null; 
      allow write: if isOwner(userId);
      
      // Transactions Sub-collection (Financial data)
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }

      // Social Interactions (Private lists)
      match /likedWebsites/{id} { allow read, write: if isOwner(userId); }
      match /userLikes/{id} { allow read, write: if isOwner(userId); }
      match /userShares/{id} { allow read, write: if isOwner(userId); }
      match /userVisits/{id} { allow read, write: if isOwner(userId); }
    }

    // Submissions Rules (The Website Directory)
    match /submissions/{submissionId} {
      // Publicly readable for the discovery feed
      allow read: if true;
      // Authenticated users can submit their websites
      allow create: if request.auth != null;
      // Only the uploader or an admin can update or delete a submission
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Website Stats Rules (Engagement metrics)
    match /websiteStats/{websiteId} {
      // Publicly readable
      allow read: if true;
      
      // Allow creation during the submission process
      allow create: if request.auth != null;

      // Restricted updates: Only admins and owners have full access.
      // Other users can ONLY perform atomic engagement increments/decrements.
      allow update: if request.auth != null && (
        isAdmin() || 
        isSubmissionOwner(websiteId) ||
        isEngagementUpdate()
      );
      
      allow delete: if isAdmin();

      function isEngagementUpdate() {
        let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return affectedKeys.hasOnly(['visitCount', 'likeCount', 'saveCount', 'shareCount', 'ratingSum', 'ratingCount']) &&
          (!affectedKeys.contains('visitCount') || (request.resource.data.visitCount == resource.data.visitCount + 1 || request.resource.data.visitCount == resource.data.visitCount - 1)) &&
          (!affectedKeys.contains('likeCount') || (request.resource.data.likeCount == resource.data.likeCount + 1 || request.resource.data.likeCount == resource.data.likeCount - 1)) &&
          (!affectedKeys.contains('saveCount') || (request.resource.data.saveCount == resource.data.saveCount + 1 || request.resource.data.saveCount == resource.data.saveCount - 1)) &&
          (!affectedKeys.contains('shareCount') || (request.resource.data.shareCount == resource.data.shareCount + 1 || request.resource.data.shareCount == resource.data.shareCount - 1)) &&
          (!affectedKeys.contains('ratingCount') || request.resource.data.ratingCount == resource.data.ratingCount + 1) &&
          (!affectedKeys.contains('ratingSum') || (request.resource.data.ratingSum >= resource.data.ratingSum + 1 && request.resource.data.ratingSum <= resource.data.ratingSum + 5));
      }

      match /userRatings/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // Promotions Rules (Ad campaigns)
    match /promotions/{promoId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}