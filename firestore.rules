
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Collection Rules ---
    
    // User can only see and manage their own connected sites
    match /collections_sites/{siteId} {
      allow read, write: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Credentials are NEVER readable or writeable by the client SDK
    // Must be handled via Admin SDK / Server Actions
    match /collections_credentials/{siteId} {
      allow read, write: if false;
    }

    // Time-series metrics for the user's sites
    match /collections_timeseries/{siteId}/buckets/{bucketId} {
      allow read: if isAuthenticated() && get(/databases/$(database)/documents/collections_sites/$(siteId)).data.ownerId == request.auth.uid;
      allow write: if false; // Only server-side sync can write
    }

    // Alerts
    match /collections_alerts/{alertId} {
      allow read, update: if isAuthenticated() && get(/databases/$(database)/documents/collections_sites/$(resource.data.siteId)).data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    // --- Existing Rules ---
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
    
    match /submissions/{subId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid);
    }

    match /websiteStats/{siteId} {
      allow read, write: if true;
    }
  }
}
