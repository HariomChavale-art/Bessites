
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Launches Rules ---
    match /launches/{launchId} {
      allow read: if true;
      allow create: if isAuthenticated() && isVerified() 
        && !exists(/databases/$(database)/documents/launchedDomains/$(request.resource.data.normalizedDomain));
      allow update: if isAuthenticated() && (
        // Only allow incrementing metrics via specific field paths
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount', 'weightedVoteScore', 'commentCount', 'uniqueClicks', 'rankingScore', 'updatedAt'])
      );
    }

    // --- Domain Lock (One Launch Per Domain) ---
    match /launchedDomains/{domain} {
      allow read: if true;
      allow create: if isAuthenticated();
    }

    // --- Determinstic Voting ---
    match /votes/{voteId} {
      // voteId MUST be launchId_userId
      allow read: if true;
      allow create: if isAuthenticated() 
        && voteId == request.resource.data.launchId + '_' + request.auth.uid;
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // --- General Rules ---
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
    
    match /submissions/{subId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid);
    }

    match /websiteStats/{siteId} {
      allow read, write: if true;
    }
    
    match /promotions/{promoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }
  }
}
