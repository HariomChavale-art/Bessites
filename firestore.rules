rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User Profile Rules
    match /users/{userId} {
      // Users can read other profiles for creator attribution. 
      // Collection-level read is allowed for authenticated users to support discovery/admin views.
      allow read: if request.auth != null; 
      allow write: if isOwner(userId) || isAdmin();
      
      // Transactions Sub-collection (Financial data)
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Social Interactions (Private lists)
      match /likedWebsites/{id} { allow read, write: if isOwner(userId); }
      match /userLikes/{id} { allow read, write: if isOwner(userId); }
      match /userShares/{id} { allow read, write: if isOwner(userId); }
      match /userVisits/{id} { allow read, write: if isOwner(userId); }
    }

    // Submissions Rules (The Website Directory)
    match /submissions/{submissionId} {
      // Publicly readable for the discovery feed
      allow read: if true;
      // Authenticated users can submit their websites
      allow create: if request.auth != null;
      // Only the uploader or an admin can update or delete a submission
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Website Stats Rules (Engagement metrics)
    match /websiteStats/{websiteId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin();

      match /userRatings/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // Promotions Rules (Ad campaigns)
    match /promotions/{promoId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}